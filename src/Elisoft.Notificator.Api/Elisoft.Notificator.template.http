@elisoft.notification_HostAddress = http://localhost:5258/

POST http://localhost:5258/api/Notification/send
Content-Type: application/json
X-API-KEY:

{
  "channel": "Slack",
  "payload": {
    "webhookUrl": "",
    "channelName": "#general",
    "message": "test"
  }
}

###

POST http://localhost:5258/api/Notification/send
Content-Type: application/json
X-API-KEY:

{
  "channel": "Email",
  "payload": {
    "to": "receiver@example.com",
    "subject": "Notificator",
    "message": "test",
    "isBodyHtml": false
  }
}

###

POST http://localhost:5258/api/Notification/send
Content-Type: application/json
X-API-KEY:

{
  "channel": "Pushover",
  "payload": {
    "message": "test",
    "title": "Notificator",
    "priority": 0
  }
}

